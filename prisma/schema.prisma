generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core Auth & Multi-Tenancy
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String    // bcrypt, never store plaintext
  name          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Set when the password changes. Sessions issued before this moment are rejected,
  // so a stolen session does not survive a password reset (BUG-09).
  passwordChangedAt DateTime?

  // Relations
  memberships   Member[]
  activityLogs  ActivityLog[]
  passwordResetTokens PasswordResetToken[]
}

model Organization {
  id              String    @id @default(cuid())
  name            String    // Biro Jasa business name
  slug            String    @unique // for subdomain or URL path
  subscriptionId  String?   // Midtrans subscription ID
  package         Package   @default(BASIC)
  operatorLimit   Int       @default(1) // based on package
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  members         Member[]
  operators       Operator[]
  files           File[]
  transactions    Transaction[]
  subscriptions   Subscription[]
  subscriptionPayments SubscriptionPayment[]
  activityLogs    ActivityLog[]
}

model Member {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole   @default(OPERATOR)
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operator       Operator?

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

enum MemberRole {
  OWNER
  OPERATOR
}

model Operator {
  id             String    @id @default(cuid())
  organizationId String
  memberId       String    @unique // the login identity this staff profile belongs to
  email          String    @unique
  name           String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting the login must never delete the staff profile,
  // because Files and Transactions point at that profile (BUG-12).
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  files          File[]
  transactions   Transaction[]
  activityLogs   ActivityLog[]

  @@index([organizationId])
}

// Subscription & Billing
model Subscription {
  id                      String        @id @default(cuid())
  organizationId          String
  midtransSubscriptionId  String? // Midtrans subscription ID
  /// A18: the payment that created this subscription. Nullable for pre-migration rows.
  subscriptionPaymentId   String?       @unique
  package                 Package
  operatorLimit           Int
  status                  SubscriptionStatus @default(ACTIVE)
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionPayment     SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

enum Package {
  BASIC   // 1 operator — limits and prices live in src/lib/plans.ts
  PRO     // 3 operators (fixed)
  CUSTOM  // flexible
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

// Core Business: Files & Transactions
model File {
  id              String    @id @default(cuid())
  organizationId  String
  operatorId      String
  customerName    String
  customerKtp     String    // encrypted
  vehicleNumber   String
  ownershipType   OwnershipType
  serviceType     ServiceType
  status          FileStatus @default(DRAFT)
  // Money is whole rupiah (Int), never Float: IDR has no sub-unit in practice
  // and integers cannot drift. Int32 ceiling: Rp 2.147.483.647 per value.
  estimatedPrice  Int       // whole rupiah
  dpAmount        Int       // whole rupiah, ~50% of estimated price
  finalPrice      Int?      // whole rupiah, total the customer pays
  samsatPayment   Int?      // whole rupiah, paid on to SAMSAT
  serviceFee      Int?      // whole rupiah, the biro's own fee — this IS the revenue
  // whole rupiah: finalPrice - samsatPayment = serviceFee. Never subtract serviceFee:
  // it is the revenue, not a cost (tdd-amendments.md A1).
  revenue         Int?
  // Set once, when status becomes PICKED_UP (A16/A17). Monthly revenue is summed over this
  // field in Asia/Jakarta, so it must be a real timestamp, not derived from updatedAt.
  pickedUpAt      DateTime?
  coverLetterPath String?   // S3/object storage URL or local path
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict: deleting a staff profile must fail loudly rather than erase revenue history (BUG-12).
  operator        Operator     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  transactions    Transaction[]

  @@index([organizationId, operatorId, status, createdAt])
}

// What SAMSAT distinguishes for a vehicle's registration and rates (A17). A select, never
// free text: spelling variants would split the revenue-per-operator report. Closed at four
// values by A23 (migration 7). "Pemerintah", never "Instansi".
enum OwnershipType {
  PERORANGAN
  BADAN_USAHA
  PEMERINTAH
  YAYASAN
}

enum ServiceType {
  STNK
  PLAT
  MUTASI
  SIM_A
  SIM_B
  SIM_C
  // Extensible for future services
}

enum FileStatus {
  DRAFT               // Initial input
  DP_PAID             // DP received
  ON_PROGRESS_SAMSAT  // Submitted to SAMSAT
  COMPLETED_SAMSAT    // Completed at SAMSAT
  PICKED_UP           // Customer picked up
  CANCELED
}

model Transaction {
  id              String    @id @default(cuid())
  organizationId  String
  operatorId      String
  fileId          String?
  type            TransactionType
  amount          Int       // whole rupiah
  paymentMethod   String?   // cash, transfer, midtrans
  midtransOrderId String?   // for gateway reconciliation
  status          TransactionStatus @default(PENDING)
  notes           String?
  createdAt       DateTime  @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict: revenue history outlives the person who recorded it (BUG-12).
  operator        Operator     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  file            File?        @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([organizationId, operatorId, createdAt])
}

enum TransactionType {
  CUSTOMER_PAYMENT  // payment from customer
  SAMSAT_PAYMENT   // payment to SAMSAT
  SERVICE_FEE      // platform fee
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Subscription billing
// One row per Midtrans payment attempt. orderId is unique and is the idempotency key:
// Midtrans redelivers notifications, and a second delivery must not activate twice.
model SubscriptionPayment {
  id             String        @id @default(cuid())
  organizationId String
  orderId        String        @unique
  amount         Int           // whole rupiah
  package        Package
  kind           PaymentKind
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription   Subscription?

  @@index([organizationId, status])
}

enum PaymentKind {
  PURCHASE  // first activation of a plan
  UPGRADE   // Basic -> Pro, billed as a new payment, never prorated
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED  // refunds are issued manually in the Midtrans dashboard
}

// Audit & Security
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // sha256 of the emailed token; the token itself is never stored
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?   // who performed the action
  operatorId     String?   // if action performed by operator
  action         String    // e.g., "FILE_CREATED", "STATUS_UPDATED", "PAYMENT_RECORDED"
  resourceType   String    // e.g., "File", "Transaction", "Operator"
  resourceId     String    // ID of the affected resource
  metadata       String?   // JSON: before/after values
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  operator       Operator?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([organizationId, resourceType, resourceId, createdAt])
}
